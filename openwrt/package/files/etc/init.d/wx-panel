#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=18
STOP=89
USE_PROCD=1
start_service() {
 procd_open_instance
 if [ -f /etc/wx-mode/current ]; then
  /usr/sbin/wx-mode-switch --boot || return 1
  procd_set_param command /usr/sbin/wx-panel
 else
  procd_set_param command /usr/sbin/wx-panel --led-only
 fi
 procd_set_param respawn 3600 5 5
 procd_open_data
 procd_close_data
 procd_close_instance
}
