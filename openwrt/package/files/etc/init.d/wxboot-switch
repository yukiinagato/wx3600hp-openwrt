#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service() {
 local system
 system="$(cat /etc/wxboot-system)"
 case "$system" in stock|openwrt) ;; *) return 1;; esac
 procd_open_instance
 procd_set_param command /usr/sbin/wxboot_choice --watch "$system"
 procd_set_param stdout 1
 procd_set_param stderr 1
 procd_set_param respawn 3600 5 3
 procd_close_instance
}
